apiVersion: {{ include "common.capabilities.statefulset.apiVersion" . }}
kind: StatefulSet
metadata:
  name: {{ template "[[ chart.chart_name ]].[[ component.name ]].fullname" . }}
  namespace: {{ include "common.names.namespace" . | quote }}
  labels: {{- include "common.labels.standard" ( dict "customLabels" .Values.commonLabels "context" $ ) | nindent 4 }}
    app.kubernetes.io/component: [[ component.name ]]
  {{- if or .Values.[[ component.values_section_name ]].statefulsetAnnotations .Values.commonAnnotations }}
  {{- $annotations := include "common.tplvalues.merge" (dict "values" (list .Values.[[ component.values_section_name ]].statefulsetAnnotations .Values.commonAnnotations) "context" .) }}
  annotations: {{- include "common.tplvalues.render" ( dict "value" $annotations "context" $ ) | nindent 4 }}
  {{- end }}
spec:
  {%- if "hpa" not in chart.disabled_templates %}
  {{- if not .Values.[[ component.values_section_name ]].autoscaling.hpa.enabled }}
  replicas: {{ .Values.[[ component.values_section_name ]].replicaCount }}
  {{- end }}
  {%- else %}
  replicas: {{ .Values.[[ component.values_section_name ]].replicaCount }}
  {%- endif %}
  podManagementPolicy: {{ .Values.podManagementPolicy | quote }}
  {{- $podLabels := include "common.tplvalues.merge" (dict "values" (list .Values.[[ component.values_section_name ]].podLabels .Values.commonLabels) "context" .) }}
  selector:
    matchLabels: {{- include "common.labels.matchLabels" ( dict "customLabels" $podLabels "context" $ ) | nindent 6 }}
      app.kubernetes.io/component: [[ component.name ]]
  serviceName: {{ template "common.names.fullname" . }}
  {{- if .Values.[[ component.values_section_name ]].updateStrategy }}
  updateStrategy: {{- toYaml .Values.[[ component.values_section_name ]].updateStrategy | nindent 4 }}
  {{- end }}
  template:
    metadata:
      {{- if .Values.[[ component.values_section_name ]].podAnnotations }}
      annotations: {{- include "common.tplvalues.render" (dict "value" .Values.[[ component.values_section_name ]].podAnnotations "context" $) | nindent 8 }}
      {{- end }}
      labels: {{- include "common.labels.standard" ( dict "customLabels" $podLabels "context" $ ) | nindent 8 }}
        app.kubernetes.io/component: [[ component.name ]]
    spec:
      {{- include "[[ chart.chart_name ]].imagePullSecrets" . | nindent 6 }}
      serviceAccountName: {{ template "[[ chart.chart_name ]].serviceAccountName" . }}
      automountServiceAccountToken: {{ .Values.[[ component.values_section_name ]].automountServiceAccountToken }}
      {{- if .Values.[[ component.values_section_name ]].hostAliases }}
      hostAliases: {{- include "common.tplvalues.render" (dict "value" .Values.[[ component.values_section_name ]].hostAliases "context" $) | nindent 8 }}
      {{- end }}
      {{- if .Values.[[ component.values_section_name ]].affinity }}
      affinity: {{- include "common.tplvalues.render" ( dict "value" .Values.[[ component.values_section_name ]].affinity "context" $) | nindent 8 }}
      {{- else }}
      affinity:
        podAffinity: {{- include "common.affinities.pods" (dict "type" .Values.[[ component.values_section_name ]].podAffinityPreset "component" "[[ component.name ]]" "customLabels" $podLabels "context" $) | nindent 10 }}
        podAntiAffinity: {{- include "common.affinities.pods" (dict "type" .Values.[[ component.values_section_name ]].podAntiAffinityPreset "component" "[[ component.name ]]" "customLabels" $podLabels "context" $) | nindent 10 }}
        nodeAffinity: {{- include "common.affinities.nodes" (dict "type" .Values.[[ component.values_section_name ]].nodeAffinityPreset.type "key" .Values.[[ component.values_section_name ]].nodeAffinityPreset.key "values" .Values.[[ component.values_section_name ]].nodeAffinityPreset.values) | nindent 10 }}
      {{- end }}
      {{- if .Values.[[ component.values_section_name ]].nodeSelector }}
      nodeSelector: {{- include "common.tplvalues.render" ( dict "value" .Values.[[ component.values_section_name ]].nodeSelector "context" $) | nindent 8 }}
      {{- end }}
      {{- if .Values.[[ component.values_section_name ]].tolerations }}
      tolerations: {{- include "common.tplvalues.render" (dict "value" .Values.[[ component.values_section_name ]].tolerations "context" .) | nindent 8 }}
      {{- end }}
      {{- if .Values.[[ component.values_section_name ]].priorityClassName }}
      priorityClassName: {{ .Values.[[ component.values_section_name ]].priorityClassName | quote }}
      {{- end }}
      {{- if .Values.[[ component.values_section_name ]].schedulerName }}
      schedulerName: {{ .Values.[[ component.values_section_name ]].schedulerName | quote }}
      {{- end }}
      {{- if .Values.[[ component.values_section_name ]].topologySpreadConstraints }}
      topologySpreadConstraints: {{- include "common.tplvalues.render" (dict "value" .Values.[[ component.values_section_name ]].topologySpreadConstraints "context" .) | nindent 8 }}
      {{- end }}
      {{- if .Values.[[ component.values_section_name ]].podSecurityContext.enabled }}
      securityContext: {{- omit .Values.[[ component.values_section_name ]].podSecurityContext "enabled" | toYaml | nindent 8 }}
      {{- end }}
      {{- if .Values.[[ component.values_section_name ]].terminationGracePeriodSeconds }}
      terminationGracePeriodSeconds: {{ .Values.[[ component.values_section_name ]].terminationGracePeriodSeconds }}
      {{- end }}
      {{- with .Values.[[ component.values_section_name ]].initContainers }}
      initContainers:
        {{- include "common.tplvalues.render" (dict "value" . "context" $) | nindent 8 }}
      {{- end }}
      containers:
        - name: [[ component.name ]]
          image: {{ template "[[ chart.chart_name ]].[[ component.name ]].image" . }}
          imagePullPolicy: {{ .Values.[[ component.values_section_name ]].image.pullPolicy }}
          {{- if .Values.[[ component.values_section_name ]].containerSecurityContext.enabled }}
          securityContext: {{- include "common.compatibility.renderSecurityContext" (dict "secContext" .Values.[[ component.values_section_name ]].containerSecurityContext "context" $) | nindent 12 }}
          {{- end }}
          {{- if .Values.diagnosticMode.enabled }}
          command: {{- include "common.tplvalues.render" (dict "value" .Values.diagnosticMode.command "context" $) | nindent 12 }}
          {{- else if .Values.[[ component.values_section_name ]].command }}
          command: {{- include "common.tplvalues.render" (dict "value" .Values.[[ component.values_section_name ]].command "context" $) | nindent 12 }}
          {{- end }}
          {{- if .Values.diagnosticMode.enabled }}
          args: {{- include "common.tplvalues.render" (dict "value" .Values.diagnosticMode.args "context" $) | nindent 12 }}
          {{- else if .Values.[[ component.values_section_name ]].args }}
          args: {{- include "common.tplvalues.render" (dict "value" .Values.[[ component.values_section_name ]].args "context" $) | nindent 12 }}
          {{- end }}
          env:
            - name: foo
              value: bar
            {{- if .Values.[[ component.values_section_name ]].extraEnvVars }}
            {{- include "common.tplvalues.render" (dict "value" .Values.[[ component.values_section_name ]].extraEnvVars "context" $) | nindent 12 }}
            {{- end }}
          envFrom:
            {{- if .Values.[[ component.values_section_name ]].extraEnvVarsCM }}
            - configMapRef:
                name: {{ include "common.tplvalues.render" (dict "value" .Values.[[ component.values_section_name ]].extraEnvVarsCM "context" $) }}
            {{- end }}
            {{- if .Values.[[ component.values_section_name ]].extraEnvVarsSecret }}
            - secretRef:
                name: {{ include "common.tplvalues.render" (dict "value" .Values.[[ component.values_section_name ]].extraEnvVarsSecret "context" $) }}
            {{- end }}
          {{- if .Values.[[ component.values_section_name ]].resources }}
          resources: {{- toYaml .Values.[[ component.values_section_name ]].resources | nindent 12 }}
          {{- else if ne .Values.[[ component.values_section_name ]].resourcesPreset "none" }}
          resources: {{- include "common.resources.preset" (dict "type" .Values.[[ component.values_section_name ]].resourcesPreset) | nindent 12 }}
          {{- end }}
          {{- with .Values.[[ component.values_section_name ]].extraContainerPorts }}
          ports:
            {{- include "common.tplvalues.render" (dict "value" . "context" $) | nindent 12 }}
          {{- end }}
          {{- if not .Values.diagnosticMode.enabled }}
          {{- if .Values.[[ component.values_section_name ]].customLivenessProbe }}
          livenessProbe: {{- include "common.tplvalues.render" (dict "value" .Values.[[ component.values_section_name ]].customLivenessProbe "context" $) | nindent 12 }}
          {{- else if .Values.[[ component.values_section_name ]].livenessProbe.enabled }}
          livenessProbe: {{- include "common.tplvalues.render" (dict "value" (omit .Values.[[ component.values_section_name ]].livenessProbe "enabled") "context" $) | nindent 12 }}
          {{- end }}
          {{- if .Values.[[ component.values_section_name ]].customReadinessProbe }}
          readinessProbe: {{- include "common.tplvalues.render" (dict "value" .Values.[[ component.values_section_name ]].customReadinessProbe "context" $) | nindent 12 }}
          {{- else if .Values.[[ component.values_section_name ]].readinessProbe.enabled }}
          readinessProbe: {{- include "common.tplvalues.render" (dict "value" (omit .Values.[[ component.values_section_name ]].readinessProbe "enabled") "context" $) | nindent 12 }}
          {{- end }}
          {{- if .Values.[[ component.values_section_name ]].customStartupProbe }}
          startupProbe: {{- include "common.tplvalues.render" (dict "value" .Values.[[ component.values_section_name ]].customStartupProbe "context" $) | nindent 12 }}
          {{- else if .Values.[[ component.values_section_name ]].startupProbe.enabled }}
          startupProbe: {{- include "common.tplvalues.render" (dict "value" (omit .Values.[[ component.values_section_name ]].startupProbe "enabled") "context" $) | nindent 12 }}
          {{- end }}
          {{- end }}
          {{- if .Values.[[ component.values_section_name ]].lifecycleHooks }}
          lifecycle: {{- include "common.tplvalues.render" (dict "value" .Values.[[ component.values_section_name ]].lifecycleHooks "context" $) | nindent 12 }}
          {{- end }}
          volumeMounts:
            - name: empty-dir
              mountPath: /tmp
              subPath: tmp-dir
          {{- if .Values.[[ component.values_section_name ]].extraVolumeMounts }}
          {{- include "common.tplvalues.render" (dict "value" .Values.[[ component.values_section_name ]].extraVolumeMounts "context" $) | nindent 12 }}
          {{- end }}
        {{- if .Values.[[ component.values_section_name ]].sidecars }}
        {{- include "common.tplvalues.render" ( dict "value" .Values.[[ component.values_section_name ]].sidecars "context" $) | nindent 8 }}
        {{- end }}
      volumes:
        - name: empty-dir
          emptyDir: {}
        {{- if .Values.[[ component.values_section_name ]].extraVolumes }}
        {{- include "common.tplvalues.render" (dict "value" .Values.[[ component.values_section_name ]].extraVolumes "context" $) | nindent 8 }}
        {{- end }}
  {%- if component.persistence %}
  {{- if .Values.[[ component.values_section_name ]].persistence.enabled }}
  volumeClaimTemplates:
    - metadata:
        name: data
        {{- if or .Values.[[ component.values_section_name ]].persistence.annotations .Values.commonAnnotations }}
        {{- $claimAnnotations := include "common.tplvalues.merge" (dict "values" .Values.[[ component.values_section_name ]].persistence.annotations .Values.commonAnnotations "context" .) | fromYaml }}
        annotations: {{- include "common.tplvalues.render" ( dict "value" $claimAnnotations "context" $ ) | nindent 10 }}
        {{- end }}
        {{- if .Values.commonLabels }}
        labels: {{- include "common.labels.matchLabels" ( dict "customLabels" .Values.commonLabels "context" $ ) | nindent 10 }}
        {{- end }}
      spec:
        accessModes:
        {{- range .Values.[[ component.values_section_name ]].persistence.accessModes }}
          - {{ . | quote }}
        {{- end }}
        resources:
          requests:
            storage: {{ .Values.[[ component.values_section_name ]].persistence.size | quote }}
        {{- if .Values.[[ component.values_section_name ]].persistence.selector }}
        selector: {{- include "common.tplvalues.render" (dict "value" .Values.[[ component.values_section_name ]].persistence.selector "context" $) | nindent 10 }}
        {{- end }}
        {{- include "common.storage.class" (dict "persistence" .Values.[[ component.values_section_name ]].persistence "global" .Values.global) | nindent 8 }}
  {{- end }}
  {%- endif %}
